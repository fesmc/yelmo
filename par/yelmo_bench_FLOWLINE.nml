! Benchmark protocol: B2 marine flowline (docs/dev/benchmark-protocol).
! Driver: tests/yelmo_bench.f90 (make bench, runme alias "bench").
! Fixture: julia --project=tests/bench tests/bench/make_fixture.jl input/bench/flowline-8km-a1.nc flowline A=4.6416e-24
!          (the fixture attributes rf_const and cf_ref give ymat.rf_const and ytill.cf_ref for its A and C)
! Check:   julia --project=tests/bench tests/bench/check_flowline.jl input/bench/flowline-8km-a1.nc <run-dir>
! All parameters not listed here come from input/yelmo_defaults.nml.

&ctrl
    time_init       = 0.0               ! [yr] Starting time
    time_end        = 5e3               ! [yr] Ending time
    dtt             = 10.0              ! [yr] Main loop time step
    dt2D_out        = 100.0             ! [yr] Frequency of 2D output
    dt_restart      = 0.0               ! [yr] Frequency of intermediate restarts yelmo_restart_<time>.nc (0: only at time_end)
/

&bench
    fixture         = "input/bench/flowline-8km-a1.nc"
    tsrf_method     = "fixed"           ! "fixed" | "lapse"
    bmb_method      = "fixed"           ! "fixed" | "mismip+"
    T_sl            = -10.0             ! [degC] lapse: temperature at sea level (unused)
    lapse           = 8e-3              ! [K m-1] lapse: lapse rate (unused)
    Omega           = 0.01              ! [yr-1] mismip+: melt-rate factor (unused)
    Hc0             = 75.0              ! [m] mismip+: water-column scale (unused)
    z0              = -200.0            ! [m] mismip+: depth above which melt is zero (unused)
/

! Strip periodic across the flow (y), divide at x = 0, ice-free x-borders.
! MISMIP densities and g (rho_ice = 900, rho_sw = 1000 kg m-3, g = 9.8 m s-2).
&yelmo
    domain          = "FLOWLINE"
    grid_name       = "FLOWLINE-8KM"
    phys_const      = "MISMIP3D"
    experiment      = "periodic-y"
/

&yelmo_masks
    basins_load     = False
    regions_load    = False
/

&yelmo_data
    pd_topo_load    = False
    pd_tsrf_load    = False
    pd_smb_load     = False
    pd_vel_load     = False
/

! Calving front fixed at x_cf by the fixture mask_ice
&ycalv
    calv_flt_method = "zero"
/

! Power-law friction tau_b = C |u|^(m-1) u: beta = c_bed (|u|/u0)^q / |u| with
! u0 = 1 m/a, q = m and c_bed = cf_ref * N_eff, N_eff = const_N = 1 Pa,
! cf_ref = C sec_year^(-m) (MISMIP: C = 7.624e6 Pa m^-1/3 s^1/3, m = 1/3).
! No reduction of sliding for a frozen bed (isothermal).
&ydyn
    beta_method     = 2
    beta_q          = 0.333333333333333
    beta_u0         = 1.0               ! [m/a]
    frz_scale       = False
/

&ytill
    scale_zb        = 0                 ! cb_ref = cf_ref everywhere
    n_sd            = 1
    cf_ref          = 24125.96298389945 ! [Pa (m/a)^-1/3] = 7.624e6 * 31556926^(-1/3)
/

&yhyd
    bkt_N_closure   = 0                 ! N_eff = const_N
    const_N         = 1.0               ! [Pa]
/

! Isothermal: constant rate factor A = rf_const (MISMIP Exp 1, A = 4.6416e-24 Pa^-3 s^-1 here;
! the fixture attribute rf_const gives the value for its A), no thermodynamics.
&ymat
    rf_method       = 0
    rf_const        = 1.464746277216e-16 ! [Pa^-3 a^-1]
/

&ytherm
    method          = "fixed"
/
