# Legacy single-file config for `python config.py config/macbook_gfortran`.
#
# The modern path is `configme config yelmo -m macbook -c gfortran`, which
# assembles compiler + machine fragments centrally. This legacy file inlines
# the per-machine/per-compiler bits only — the shared dependency wiring
# (FESMUTILS, LIS, FASTHYDRO, ...) is included by the top-level Makefile
# template via `include config/common.mk`, so it lives in exactly one place.

FC = gfortran

# ajr: set NC_CROOT and NC_FROOT in .zshrc
INC_NC = -I${NC_FROOT}/include
LIB_NC = -L${NC_FROOT}/lib -lnetcdff -L${NC_CROOT}/lib -lnetcdf

# Compiler flags (gfortran). FFLAGS_OPENMP is appended by common.mk when
# building with `make openmp=1`.
FFLAGS = -I$(objdir) -J$(objdir) -ffree-line-length-none
FFLAGS_OPENMP = -fopenmp

# Optional PETSc (enabled with `make petsc=1`); PETSC_DIR comes from env.
PETSCROOT = /opt/local/lib/petsc
INC_PETSC = -I $(PETSC_DIR)/include
LIB_PETSC = -L${PETSC_DIR}/lib -lpetsc

# Apple ld (ld64) rejects -Wl,-zmuldefs (GNU-ld/ELF flag). Disable it before
# common.mk's `LFLAGS_EXTRA ?= -Wl,-zmuldefs` runs.
LFLAGS_EXTRA =

DFLAGS_NODEBUG = -O2 -march=native
DFLAGS_DEBUG   = -w -g -ggdb -ffpe-trap=invalid,zero,overflow -fbacktrace -fcheck=all -Wp,-DDEBUG
DFLAGS_PROFILE = -O2 -p -ggdb
